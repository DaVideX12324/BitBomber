[gd_scene format=3]

[node name="SetRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 54)
mouse_filter = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"ListRow"

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Toggle" type="CheckButton" parent="HBox"]
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "Używany w grach"

[node name="Name" type="Label" parent="HBox"]
auto_translate_mode = 2
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Nazwa zestawu"
text_overrun_behavior = 3

[node name="Tag" type="Label" parent="HBox"]
auto_translate_mode = 2
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_font_sizes/font_size = 18

[node name="Count" type="Label" parent="HBox"]
auto_translate_mode = 2
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_font_sizes/font_size = 19
text = "40 pytań"
horizontal_alignment = 2

[node name="Arrow" type="Label" parent="HBox"]
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_font_sizes/font_size = 30
text = "›"
